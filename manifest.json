{
  "name": "AI Translator Assistant",
  "description": "Translate, correct, and refine selected text using Chrome built-in AI.",
  "version": "1.0.0",
  "manifest_version": 3,
  "minimum_chrome_version": "138",
  "icons": {
    "128": "icons/QuickTranslateIcon_128.png"
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "128": "icons/QuickTranslateIcon_128.png"
    },
    "default_popup": "popup.html"
  }
}
